# Example environment for the MySQL + Weaviate deployment.
# Copy to `.env.development` (or your target env) and run with:
#   COMPOSE_PROFILES=mysql make stack-up ENV=development
#
# Only the database/vector-store section differs from .env.example — see that
# file for the full set of application, LLM, JWT, and rate-limit settings.

APP_ENV=development
PROJECT_NAME="Web Assistant"
DEBUG=true

OPENAI_API_KEY="your-llm-api-key"
DEFAULT_LLM_MODEL=gpt-5-mini
JWT_SECRET_KEY="your-jwt-secret-key"

# ---------------------------------------------------------------------------
# Database — MySQL 8+
# ---------------------------------------------------------------------------
DB_DIALECT=mysql
DB_HOST=mysql            # docker compose service name (see docker-compose.yml)
DB_PORT=3306
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword
DB_ROOT_PASSWORD=rootpassword   # used by the mysql container + healthcheck
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Long-term memory vector store — Weaviate (pgvector cannot run on MySQL)
# ---------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=weaviate
WEAVIATE_CLUSTER_URL=http://weaviate:8080
WEAVIATE_API_KEY=
